compatibility_level = 2
queue_directory = /tmp/milterguard-exactdkim-postfix/queue
data_directory = /tmp/milterguard-exactdkim-postfix/data
command_directory = /usr/sbin
daemon_directory = /usr/libexec/postfix
meta_directory = /etc/postfix
shlib_directory = /usr/lib64/postfix
mail_owner = postfix
setgid_group = postdrop
myhostname = exactdkim.example.test
mydomain = example.test
myorigin = $mydomain
inet_interfaces = 127.0.0.1
inet_protocols = ipv4
mydestination = example.test
mynetworks = 127.0.0.0/8
local_transport = discard:
relay_transport = discard:
alias_maps =
alias_database =
local_recipient_maps =
smtpd_reject_unlisted_recipient = no
smtpd_relay_restrictions = permit_mynetworks, reject
smtpd_recipient_restrictions = permit_mynetworks, reject
smtpd_milters = inet:127.0.0.1:18894, inet:127.0.0.1:18895
non_smtpd_milters =
milter_protocol = 6
milter_default_action = tempfail
milter_connect_timeout = 10s
milter_command_timeout = 10s
milter_content_timeout = 30s
maillog_file = /tmp/milterguard-exactdkim-postfix/postfix.log
maillog_file_prefixes = /tmp/milterguard-exactdkim-postfix
